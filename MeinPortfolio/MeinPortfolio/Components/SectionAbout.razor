@inject LanguageService LanguageService
@implements IDisposable


<section id="about" class="section">
    <div class="container">
        <h2 class="section-title">@LanguageService.GetText("Über mich", "About Me")</h2>
        <div class="about-content">
            <div class="about-text">
                <p class="about-intro">
                @LanguageService.GetText(
                    "Hallo! Ich bin Moritz, ein " + @Age + "-jähriger staatlich geprüfter Wirtschaftsinformatiker mit Erfahrung in der professionellen Softwareentwicklung. Ich arbeite sowohl im C#/.NET- als auch im Java/Spring-Boot-Ökosystem und bringe Leidenschaft für sauberen Code und moderne Architekturen mit.",
                    "Hello! I'm Moritz, a " + @Age + "-year-old certified business informatics specialist with professional software development experience. I work across both the C#/.NET and Java/Spring Boot ecosystems and bring a passion for clean code and modern architectures.")
                </p>
                <div class="about-details">
                    <div class="about-item">
                        <h3>@LanguageService.GetText("Ausbildung", "Education")</h3>
                        <p>@LanguageService.GetText("Staatlich geprüfter Wirtschaftsinformatiker", "State-certified Business Informatics Specialist")</p>
                    </div>
                    <div class="about-item">
                        <h3>@LanguageService.GetText("Fokus", "Focus")</h3>
                        <p>@LanguageService.GetText("Backend-Entwicklung mit C#/.NET & Java/Spring Boot", "Backend development with C#/.NET & Java/Spring Boot")</p>                    
                    </div>
                    <div class="about-item">
                        <h3>@LanguageService.GetText("Erfahrung", "Experience")</h3>
                        <p>@LanguageService.GetText("Software Developer bei Smart InsurTech AG (Jan 2026 - heute)", "Software Developer at Smart InsurTech AG (Jan 2026 - today)")</p>
                    </div>
                    <div class="about-item">
                        <h3>@LanguageService.GetText("Motivation", "Motivation")</h3>
                        <p>@LanguageService.GetText("Innovative Lösungen entwickeln und mich kontinuierlich in neuen Technologien weiterentwickeln", "Building innovative solutions and continuously expanding my skills in new technologies")</p>
                    </div>
                    <div class="about-item">
                        <h3>@LanguageService.GetText("Interessen", "Interests")</h3>
                        <p>
                            @LanguageService.GetText(
                                "Norwegisch lernen & skandinavische Kultur, Backpacking & Wandern, persönliche Nebenprojekte sowie American Football.",
                                "Learning Norwegian & Scandinavian culture, backpacking & hiking, personal side projects, and American football."
                            )
                        </p>
                    </div>

                </div>
            </div>
            <div class="about-stats">
                <div class="stat-item">
                        <span class="stat-number">@Age</span>
                        <span class="stat-label">@LanguageService.GetText("Jahre alt", "Years old")</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">5+</span>
                    <span class="stat-label">@LanguageService.GetText("Projekte", "Projects")</span>
                </div>
       
                <div class="stat-item">
                    <span class="stat-number">100%</span>
                    <span class="stat-label">@LanguageService.GetText("Motivation", "Motivation")</span>
                </div>
            </div>
        </div>
    </div>
</section>


@code {
    
    private static readonly DateTime BirthDate = new DateTime(2002, 9, 3); 

    private int Age {
        get {
            var today = DateTime.Today;
            var age = today.Year - BirthDate.Year;
            if (BirthDate.Date > today.AddYears(-age)) age--;
            return age;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        LanguageService.OnLanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(LanguageType language)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        LanguageService.OnLanguageChanged -= OnLanguageChanged;
    }
    
   

}