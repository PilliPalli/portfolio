@using MeinPortfolio.Services
@using MeinPortfolio.Models
@using MeinPortfolio.Models.Commands
@inject LanguageService LanguageService
@inject NavigationService NavigationService
@inject CommandService CommandService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<section id="home" class="intro-section">
    <div class="intro-container">
        <div class="intro-content">
            <div class="intro-text">
                <h1 class="intro-title">Moritz Kreis</h1>
                <h2 class="intro-subtitle">C#/.NET Developer</h2>
                <p class="intro-description">
                    @LanguageService.GetText(
                        "Staatlich geprüfter Wirtschaftsinformatiker mit Schwerpunkt Anwendungsentwicklung. Entdecke mein interaktives Terminal-Portfolio oder scrolle durch die klassische Übersicht.",
                        "State-certified business IT specialist with a focus on software development. Explore my interactive terminal portfolio or scroll through the classic overview.")
                </p>
                <div class="intro-buttons">
                    <a href="#projects" class="btn btn-primary">@LanguageService.GetText("Meine Arbeit", "My Work")</a>
                    <a href="@LanguageService.GetCvPath()" class="btn btn-outline" target="_blank">@LanguageService.GetText("Lebenslauf herunterladen", "Download CV")</a>
                </div>
            </div>

            <div class="intro-panel">
                <div class="terminal">
                    <div class="terminal-header">
                        <div>Terminal Portfolio - @NavigationService.GetSectionPath()</div>
                    </div>
                    <div class="terminal-body" id="terminal-body">
                        @foreach (var line in _output)
                        {
                            if (line.IsHtml)
                            {
                                <div>@((MarkupString)line.Content)</div>
                            }
                            else
                            {
                                <div>@line.Content</div>
                            }
                        }
                    </div>
                    <div class="terminal-input">
                        <span>$ </span>
                        <input
                            @bind="_input"
                            @bind:event="oninput"
                            @onkeydown="HandleKeyPress"
                            @onkeydown:stopPropagation
                            autofocus />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
