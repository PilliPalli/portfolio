@using MeinPortfolio.Services
@inject LanguageService LanguageService
@implements IDisposable


<nav class="top-nav">
    <div class="nav-container">
        <div class="nav-brand">
            <a href="#home" class="nav-logo">MK</a>
        </div>

        <!-- Hamburger nur auf Mobile sichtbar (per CSS) -->
        <button class="nav-toggle"
                @onclick="ToggleMenu"
                aria-expanded="@_isMenuOpen"
                aria-controls="primary-nav"
                aria-label="Menü öffnen/schließen">
            <img src="images/hamburger.svg" alt="hamburger-icon"/>
        </button>

        <div id="primary-nav" class="nav-links @(_isMenuOpen ? "open" : null)">
            <a href="#home" class="nav-link" @onclick="CloseMenu">@LanguageService.GetText("Home", "Home")</a>
            <a href="#about" class="nav-link" @onclick="CloseMenu">@LanguageService.GetText("Über mich", "About")</a>
            <a href="#experience" class="nav-link" @onclick="CloseMenu">@LanguageService.GetText("Erfahrung","Experience")</a>
            <a href="#projects" class="nav-link" @onclick="CloseMenu">@LanguageService.GetText("Projekte", "Projects")</a>
            <a href="#contact" class="nav-link" @onclick="CloseMenu">@LanguageService.GetText("Kontakt", "Contact")</a>
            <a href="@LanguageService.GetCvPath()" class="nav-link nav-cv" target="_blank" @onclick="CloseMenu">CV</a>
            <button class="nav-language-btn" @onclick="ToggleLanguage">
                @(LanguageService.CurrentLanguage == LanguageType.German ? "EN" : "DE")
            </button>
        </div>
    </div>
</nav>


@code {

    private bool _isMenuOpen;

    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;
    private void CloseMenu() => _isMenuOpen = false;
    
    protected override async Task OnInitializedAsync()
    {
        await LanguageService.InitializeAsync();
        LanguageService.OnLanguageChanged += OnLanguageChanged;
        
    }

    protected async Task ToggleLanguage()
    {
        if (LanguageService.CurrentLanguage == LanguageType.German)
        {
            await LanguageService.SetLanguageAsync(LanguageType.English);
        }
        else
        {
            await LanguageService.SetLanguageAsync(LanguageType.German);
        }
        CloseMenu();
    }
    
    private void OnLanguageChanged(LanguageType _) => StateHasChanged();

    public void Dispose()
    {
        LanguageService.OnLanguageChanged -= OnLanguageChanged;
    }
}