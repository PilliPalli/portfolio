@using MeinPortfolio.Models
@using MeinPortfolio.Services
@inject LanguageService LanguageService
@inject FeatureFlags Features
@implements IDisposable

<section id="projects" class="section">
    <div class="container">
        <h2 class="section-title">@LanguageService.GetText("Projekte", "Projects")</h2>
        <div class="projects-grid">
            @foreach (var project in GetLocalizedProjects())
            {
                <ProjectCard Project="project" />
            }
        </div>
    </div>
</section>

@code {
    public List<Project> GetLocalizedProjects()
    {
        if (LanguageService.CurrentLanguage == LanguageType.German)
        {
            return new List<Project>
            {
                new Project
                {
                    Title = "Interaktives Terminal-Portfolio",
                    Description = Features.AiEnabled
                        ? "Eine Blazor-basierte Portfolio-Website mit klassischer Übersicht, interaktivem Terminal und eigenständigem API-gestütztem Code-Generator. Nutzer können über Unix-ähnliche Befehle navigieren, Inhalte erkunden oder den Code-Generator verwenden."
                        : "Eine Portfolio-Website mit integriertem Terminal und Informationen über meine Person. Nutzer können durch Unix-ähnliche Befehle navigieren und Inhalte erkunden.",
                    TechStack = Features.AiEnabled
                        ? new List<string> { "C#", "Blazor WebAssembly", "HTML/CSS", "JavaScript", "OpenAI API" }
                        : new List<string> { "C#", "Blazor WebAssembly", "HTML/CSS", "JavaScript" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "PDF-Generator für Suchstaffel",
                    Description = "Webanwendung zur automatischen Erstellung von PDF-Berichten für Einsätze einer Suchhundestaffel. Unterstützt aktiv die Bekämpfung der Afrikanischen Schweinepest in Hessen und Rheinland-Pfalz.",
                    TechStack = new List<string> { "C#", "Blazor Server", "PostgreSQL", "PDF Generation" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "Schwimmbad-Verwaltung",
                    Description = "Anwendung zur Verwaltung von Mitgliedern eines fiktiven Schwimmbads inklusive Datenbankanbindung und Mitgliederverwaltung.",
                    TechStack = new List<string> { "C#", "WPF", "MSSQL", "Entity Framework" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "Code-Kommentierungstool",
                    Description = "Anwendung zur automatischen Kommentierung von Quellcode über die ChatGPT-API, konfigurierbar nach Detailtiefe und Programmiersprache.",
                    TechStack = new List<string> { "C#", "WPF", "OpenAI API", "File Processing" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "Garbage Collection Tool",
                    Description = "Tool zur automatisierten Löschung temporärer Dateien inklusive Scheduler, Login-System und Datenbank für Konfigurationsverwaltung.",
                    TechStack = new List<string> { "C#", "WPF", "Task Scheduling", "MSSQL", "Docker" },
                    CodeUrl = null,
                    LiveUrl = null
                }
            };
        }
        else
        {
            return new List<Project>
            {
                new Project
                {
                    Title = "Interactive Terminal Portfolio",
                    Description = Features.AiEnabled
                        ? "A Blazor-based portfolio website with a classic overview, an interactive terminal, and a standalone API-powered code generator. Users can navigate using Unix-like commands, explore content, or try the code generator."
                        : "A portfolio website with an integrated terminal providing information about myself. Users can navigate and explore content through Unix-like commands.",
                    TechStack = Features.AiEnabled
                        ? new List<string> { "C#", "Blazor WebAssembly", "HTML/CSS", "JavaScript", "OpenAI API" }
                        : new List<string> { "C#", "Blazor WebAssembly", "CSS", "JavaScript" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "PDF Generator for Search Squad",
                    Description = "Web application for automatic creation of PDF reports for search dog squad operations. Actively supports the fight against African Swine Fever in Hesse and Rhineland-Palatinate.",
                    TechStack = new List<string> { "C#", "Blazor Server", "PostgreSQL", "PDF Generation" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "Swimming Pool Management",
                    Description = "Application for managing members of a fictional swimming pool including database connection and member management.",
                    TechStack = new List<string> { "C#", "WPF", "MSSQL", "Entity Framework" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "Code Commenting Tool",
                    Description = "Application for automatic commenting of source code via ChatGPT API, configurable by detail level and programming language.",
                    TechStack = new List<string> { "C#", "WPF", "OpenAI API", "File Processing" },
                    CodeUrl = null,
                    LiveUrl = null
                },
                new Project
                {
                    Title = "Garbage Collection Tool",
                    Description = "Tool for automated deletion of temporary files including scheduler, login system and database for configuration management.",
                    TechStack = new List<string> { "C#", "WPF", "Task Scheduling", "MSSQL", "Docker" },
                    CodeUrl = null,
                    LiveUrl = null
                }
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LanguageService.OnLanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(LanguageType language)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        LanguageService.OnLanguageChanged -= OnLanguageChanged;
    }
}
