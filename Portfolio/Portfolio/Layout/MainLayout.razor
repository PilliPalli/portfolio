@using Portfolio.Components
@inherits LayoutComponentBase
@inject LanguageService LanguageService
@implements IDisposable

<div class="page">
    <TopNav/>
    <main>
        @Body
    </main>
    <footer class="legal-footer">
        <span>© @DateTime.Now.Year Moritz Kreis</span>
        <nav aria-label="Rechtliche Informationen">
            <a href="datenschutz">@LanguageService.GetText("Datenschutz", "Privacy")</a>
        </nav>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        LanguageService.OnLanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged(LanguageType language)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LanguageService.OnLanguageChanged -= OnLanguageChanged;
    }
}
